## Bloques (ver BlockCatalog y Level) de los niveles que no traen "theme",
## por tramos: [primer nivel (desde 0), tema]. Siguen las zonas del mapa de
## niveles (ver LevelMap):
## - Zona I, «El mundo de los cubos» (niveles 1-34): praderas, aldeas y
##   ruinas de piedra (hierba, tierra, sillería, tronco, ladrillo).
## - Zona II, «Las tierras salvajes» (niveles 35-60): islas flotantes que
##   suben desde los prados en flor hasta las cumbres nevadas. Sus niveles
##   36-60 traen además "theme_regions" con el suelo de las islas
##   amuralladas y de los puentes de tierra (ver tools/build_islands.py).
const THEMES := [
	# Zona I
	[0, {"floor": "grass", "wall": "stone_bricks"}],
	[5, {"floor": "grass_flowers", "wall": "wood_log"}],
	[10, {"floor": "grass", "wall": "brick"}],
	[13, {"floor": "dirt", "wall": "mossy_stone"}],
	[17, {"floor": "stone", "wall": "stone_bricks"}],
	[21, {"floor": "wood_planks", "wall": "brick"}],
	[24, {"floor": "grass", "wall": "wood_log"}],
	[27, {"floor": "grass_dry", "wall": "stone"}],
	[30, {"floor": "grass", "wall": "mossy_stone"}],
	[32, {"floor": "grass_flowers", "wall": "stone_bricks"}],
	# Zona II
	[34, {"floor": "grass_flowers", "wall": "mossy_stone", "foundation": "stone"}],
	[40, {"floor": "grass", "wall": "mossy_stone", "foundation": "stone"}],
	[44, {"floor": "grass_dry", "wall": "wood_log", "foundation": "stone"}],
	[48, {"floor": "stone", "wall": "granite"}],
	[52, {"floor": "snow", "wall": "snow"}],
	[56, {"floor": "snow", "wall": "ice", "foundation": "stone"}],
]


static func count() -> int:
	return LIST.size()


## Datos del nivel. Si no trae "theme", lleva el de su tramo en THEMES.
static func get_level(index: int) -> Dictionary:
	index = clampi(index, 0, LIST.size() - 1)
	var data: Dictionary = LIST[index]
	if data.has("theme"):
		return data
	data = data.duplicate()
	for entry: Array in THEMES:
		if index >= entry[0]:
			data["theme"] = entry[1]
	return data
